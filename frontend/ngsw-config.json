{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": [
    "/**",
    "!/**/*.__*",
    "!/**/*.__*/**",
    "!/api/**",
    "!/.well-known/**",
    "!/ics/**",
    "!/k/**",
    "!/abo/**",
    "!/bestaetigen/**",
    "!/tiles/**",
    "!/sitemap.xml",
    "!/robots.txt"
  ],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "today",
      "urls": [
        "/api/public/today"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "3s",
        "maxAge": "1d",
        "maxSize": 5
      }
    },
    {
      "name": "events",
      "urls": [
        "/api/public/events/*"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "3s",
        "maxAge": "1d",
        "maxSize": 30
      }
    }
  ]
}
