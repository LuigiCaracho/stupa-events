**/dist
frontend/.angular
frontend/e2e
**/coverage
.git
**/__pycache__
**/.venv
**/.pytest_cache
**/.ruff_cache
**/.hypothesis
**/.coverage
backend/tests
backend/scripts
docs
deploy
**/.env
**/.env.*
!**/.env.example
!**/.env.dev.example
**/secrets
