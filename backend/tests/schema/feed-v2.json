{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STUPA Events public feed, schema 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generatedAt",
    "nextCursor",
    "items"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_=-]*$"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title",
        "summary",
        "startsAt",
        "endsAt",
        "allDay",
        "startsOn",
        "endsOn",
        "tzid",
        "status",
        "organization",
        "venueText",
        "venue",
        "statusReason",
        "categories",
        "format",
        "image",
        "ticketUrl",
        "websiteUrl",
        "costText",
        "textHtml",
        "sequence",
        "updatedAt",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "slug": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "startsAt": {
          "type": "string",
          "pattern": "Z$"
        },
        "endsAt": {
          "type": "string",
          "pattern": "Z$"
        },
        "allDay": {
          "type": "boolean"
        },
        "startsOn": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "endsOn": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "tzid": {
          "const": "Europe/Berlin"
        },
        "status": {
          "enum": [
            "scheduled",
            "cancelled",
            "postponed"
          ]
        },
        "organization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "slug",
            "name",
            "short"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "slug": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,59}$"
            },
            "name": {
              "type": "string"
            },
            "short": {
              "type": "string"
            }
          }
        },
        "venueText": {
          "type": [
            "string",
            "null"
          ]
        },
        "venue": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "address",
                "city"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "address": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "city": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "statusReason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "text"
              ],
              "properties": {
                "code": {
                  "enum": [
                    "none",
                    "room",
                    "speaker",
                    "illness",
                    "registration",
                    "weather",
                    "other"
                  ]
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 140
                }
              }
            }
          ]
        },
        "categories": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slug",
              "name",
              "kind"
            ],
            "properties": {
              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "format",
                  "fachschaft",
                  "partner"
                ]
              }
            }
          }
        },
        "format": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "slug",
                "title"
              ],
              "properties": {
                "slug": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,59}$"
                },
                "title": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "image": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "width",
                "height",
                "alt",
                "credit"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "/api/public/media/[0-9a-f]{16}-card_1200\\.webp$"
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                },
                "alt": {
                  "type": "string"
                },
                "credit": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "ticketUrl": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        },
        "websiteUrl": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        },
        "costText": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "textHtml": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "type": "string",
          "pattern": "Z$"
        },
        "url": {
          "type": "string",
          "pattern": "/e/[a-z0-9-]+$"
        }
      }
    }
  }
}
