# STUPA Events: local development. Copy to deploy/.env.dev (gitignored). Every value is a throwaway
# fixture for a local stack, never reuse it elsewhere.
# Full stack: docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.keycloak.yml --env-file deploy/.env.dev up -d --build
# For host-run uvicorn/arq against deploy/docker-compose.dev.yml, see the host block at the end.

ENVIRONMENT=development
STRICT_SECURITY=true
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8081
LOCAL_TIMEZONE=Europe/Berlin

DATABASE_URL=postgresql+asyncpg://events_app:dev-app@postgres/events
DB_MIGRATION_URL=postgresql+asyncpg://events_migrator:dev-migrator@postgres/events
PUBLIC_DATABASE_URL=postgresql+asyncpg://events_public:dev-public@postgres/events
REDIS_URL=redis://redis:6379/0
ARQ_QUEUE_NAME=events

SESSION_SECRET=dev-session-secret-0001
SESSION_COOKIE_NAME=ev_session
OIDC_TX_COOKIE_NAME=ev_oidc_tx
SESSION_REVALIDATE_HOURS=4
SESSION_REVALIDATE_GRACE_HOURS=24
COOKIE_SECURE=false
CSRF_ENABLED=true
CSRF_COOKIE_NAME=XSRF-TOKEN
CSRF_HEADER_NAME=X-XSRF-TOKEN
CORS_ALLOW_ORIGINS=

FORWARDED_ALLOW_IPS=172.29.10.10

# Dev has no TLS proxy: 192.0.2.1 (TEST-NET-1) trusts nobody.
TRUSTED_PROXY_IP=192.0.2.1

OIDC_ISSUER=http://host.docker.internal:8090/realms/stupa-events
OIDC_CLIENT_ID=stupa-events
OIDC_CLIENT_SECRET=stupa-events-dev-secret-0001
OIDC_REDIRECT_URL=http://localhost:8081/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URL=http://localhost:8081/
OIDC_SCOPES=openid email profile offline_access
OIDC_GROUPS_CLAIM=groups
BOOTSTRAP_ADMIN_SUBJECTS=
BOOTSTRAP_ADMIN_EMAILS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=noreply@events.local
MAIL_FROM_NAME=STUPA Events
MAIL_DEFAULT_LANG=de

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=dev-minio
MINIO_SECRET_KEY=dev-minio-secret
MINIO_SECURE=false
MINIO_BUCKET=events-attachments
MINIO_PUBLIC_BUCKET=events-public
ATTACHMENT_MAX_BYTES=10485760

CLAMAV_HOST=clamav
CLAMAV_PORT=3310

BACKUP_BUCKET=events-backups
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=/secrets/backup-age.key
BACKUP_RETENTION_COUNT=14

RATE_LIMIT_ENABLED=true
PUBLISH_REQUIRES_EDITOR=false

ENV_FILE=.env.dev
WEB_PORT=8081
POSTGRES_PASSWORD=dev-postgres
EVENTS_APP_PASSWORD=dev-app
EVENTS_MIGRATOR_PASSWORD=dev-migrator
EVENTS_PUBLIC_PASSWORD=dev-public
MINIO_ROOT_USER=dev-minio
MINIO_ROOT_PASSWORD=dev-minio-secret

# Host-run backend against docker-compose.dev.yml (override the container hosts above):
# DATABASE_URL=postgresql+asyncpg://events_app:dev-app@localhost:5434/events
# DB_MIGRATION_URL=postgresql+asyncpg://events_migrator:dev-migrator@localhost:5434/events
# PUBLIC_DATABASE_URL=postgresql+asyncpg://events_public:dev-public@localhost:5434/events
# REDIS_URL=redis://localhost:6381/0
# MINIO_ENDPOINT=localhost:9100
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3311
# OIDC_REDIRECT_URL=http://localhost:4200/api/auth/callback   (ng serve proxies /api to :8000)
