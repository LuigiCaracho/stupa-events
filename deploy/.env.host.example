# Host-run backend (uvicorn on :8000, ng serve on :4200) against deploy/docker-compose.dev.yml.
# Copy to backend/.env (gitignored). Every value is a throwaway fixture of the local stack.
# The issuer uses localhost because browser and host-run API both reach Keycloak there.

ENVIRONMENT=development
STRICT_SECURITY=true
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:4200
LOCAL_TIMEZONE=Europe/Berlin
DATABASE_URL=postgresql+asyncpg://events_app:dev-app@localhost:5434/events
DB_MIGRATION_URL=postgresql+asyncpg://events_migrator:dev-migrator@localhost:5434/events
PUBLIC_DATABASE_URL=postgresql+asyncpg://events_public:dev-public@localhost:5434/events
REDIS_URL=redis://localhost:6381/0
ARQ_QUEUE_NAME=events
SESSION_SECRET=dev-session-secret-0001
SESSION_COOKIE_NAME=ev_session
OIDC_TX_COOKIE_NAME=ev_oidc_tx
SESSION_REVALIDATE_HOURS=4
SESSION_REVALIDATE_GRACE_HOURS=24
COOKIE_SECURE=false
CSRF_ENABLED=true
CSRF_COOKIE_NAME=XSRF-TOKEN
CSRF_HEADER_NAME=X-XSRF-TOKEN
CORS_ALLOW_ORIGINS=
FORWARDED_ALLOW_IPS=127.0.0.1
OIDC_ISSUER=http://localhost:8090/realms/stupa-events
OIDC_CLIENT_ID=stupa-events
OIDC_CLIENT_SECRET=stupa-events-dev-secret-0001
OIDC_REDIRECT_URL=http://localhost:4200/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URL=http://localhost:4200/
OIDC_SCOPES="openid email profile offline_access"
OIDC_GROUPS_CLAIM=groups
BOOTSTRAP_ADMIN_SUBJECTS=
BOOTSTRAP_ADMIN_EMAILS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=noreply@events.local
MAIL_FROM_NAME="STUPA Events"
MAIL_DEFAULT_LANG=de
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=dev-minio
MINIO_SECRET_KEY=dev-minio-secret
MINIO_SECURE=false
MINIO_BUCKET=events-attachments
MINIO_PUBLIC_BUCKET=events-public
ATTACHMENT_MAX_BYTES=10485760
CLAMAV_HOST=localhost
CLAMAV_PORT=3311
BACKUP_BUCKET=events-backups
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=
BACKUP_RETENTION_COUNT=14
RATE_LIMIT_ENABLED=true
EDITOR_FOUR_EYES=false
