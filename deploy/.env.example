# Copied from STUPA-Workflow@93c33d6 deploy/.env.example (adapted).
# STUPA Events: production config. Copy to deploy/.env, replace every CHANGE_ME, NEVER commit.
# Secrets are fresh and never equal to the Workflow stack's. deploy.sh refuses a leftover CHANGE_ME.
# Names equal the fields of backend/app/settings.py (test_env_example_settings_parity); the
# "compose only" block at the end is read by docker compose and ignored by the app.

ENVIRONMENT=production
STRICT_SECURITY=true
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://events.reutlingen.university
LOCAL_TIMEZONE=Europe/Berlin
# Calendar UIDs are <event id>@<domain>; changing the domain duplicates every subscribed event.
ICS_UID_DOMAIN=events.reutlingen.university
# Worker snapshots of the feed and the calendars (Redis): oldest age served, row cap.
PUBLIC_SNAPSHOT_MAX_AGE_SECONDS=7200
PUBLIC_SNAPSHOT_MAX_ROWS=5000
# Internal search: requests per person and minute.
RL_SEARCH_PER_MINUTE=240
# Public pages and JSON: cache misses per IP and minute (hits are free); misses of a text search.
RL_PUBLIC_PER_MINUTE=120
RL_PUBLIC_SEARCH_PER_MINUTE=30
# Built SPA index.html that the HTML shell fills with title, Open Graph and JSON-LD.
SPA_INDEX_PATH=/app/spa/index.html

DATABASE_URL=postgresql+asyncpg://events_app:CHANGE_ME@postgres/events
DB_MIGRATION_URL=postgresql+asyncpg://events_migrator:CHANGE_ME@postgres/events
PUBLIC_DATABASE_URL=postgresql+asyncpg://events_public:CHANGE_ME@postgres/events
REDIS_URL=redis://redis:6379/0
ARQ_QUEUE_NAME=events

SESSION_SECRET=CHANGE_ME_AT_LEAST_16_CHARS
SESSION_COOKIE_NAME=ev_session
OIDC_TX_COOKIE_NAME=ev_oidc_tx
SESSION_REVALIDATE_HOURS=4
SESSION_REVALIDATE_GRACE_HOURS=24
COOKIE_SECURE=true
CSRF_ENABLED=true
CSRF_COOKIE_NAME=XSRF-TOKEN
CSRF_HEADER_NAME=X-XSRF-TOKEN
CORS_ALLOW_ORIGINS=

# Only the exact IP of the direct upstream (web, fixed in docker-compose.yml). Never "*", never RFC1918 ranges.
FORWARDED_ALLOW_IPS=172.29.10.10

# Address nginx sees the TLS proxy (Caddy) from, e.g. the compose network gateway 172.29.10.1 when Caddy runs
# on the host. Exact IP only. Required: while it is empty or 192.0.2.1 every visitor shares one rate-limit key.
TRUSTED_PROXY_IP=

# Authentik provider `stupa-events`. The issuer keeps its trailing slash (docs/authentik/README.md).
OIDC_ISSUER=https://sso.reutlingen.university/application/o/stupa-events/
OIDC_CLIENT_ID=stupa-events
OIDC_CLIENT_SECRET=CHANGE_ME_AT_LEAST_16_CHARS
OIDC_REDIRECT_URL=https://events.reutlingen.university/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URL=https://events.reutlingen.university/
OIDC_SCOPES=openid email profile offline_access
OIDC_GROUPS_CLAIM=groups
BOOTSTRAP_ADMIN_SUBJECTS=
BOOTSTRAP_ADMIN_EMAILS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=
MAIL_FROM_NAME=STUPA Events
MAIL_DEFAULT_LANG=de

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false
MINIO_BUCKET=events-attachments
MINIO_PUBLIC_BUCKET=events-public
ATTACHMENT_MAX_BYTES=10485760

CLAMAV_HOST=clamav
CLAMAV_PORT=3310

BACKUP_BUCKET=events-backups
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=/secrets/backup-age.key
BACKUP_RETENTION_COUNT=14

RATE_LIMIT_ENABLED=true
PUBLISH_REQUIRES_EDITOR=false

# Get started and mail subscriptions (docs/secrets.md). The two keys differ, never rotate without a migration.
SUBS_DATABASE_URL=postgresql+asyncpg://events_subs:CHANGE_ME@postgres/events
PGCRYPTO_EMAIL_KEY=CHANGE_ME_AT_LEAST_32_CHARS
EMAIL_HASH_KEY=CHANGE_ME_AT_LEAST_32_CHARS
ALTCHA_HMAC_SECRET=CHANGE_ME_AT_LEAST_16_CHARS
MIN_RESPONSE_SECONDS=0.6
# Listmonk runs outside this stack (https only, host must be in the allowlist).
LISTMONK_URL=https://CHANGE_ME
LISTMONK_API_USER=events-api
LISTMONK_API_TOKEN=CHANGE_ME_AT_LEAST_16_CHARS
LISTMONK_ALLOWED_HOSTS=CHANGE_ME
# Geocoding of venue addresses on a button press (Nominatim usage policy: one request per 2 s, contact in the User-Agent).
NOMINATIM_ENABLED=false
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT=CHANGE_ME

# Imports (M6). Sources are fetched by the worker; the fixture directory enables the development-only fixture run.
IMPORT_LOCK_TTL_S=900
IMPORT_MAX_ITEMS=200
IMPORT_HTTP_TIMEOUT_S=15.0
IMPORT_HTTP_MAX_BYTES=2097152
IMPORT_IMAGE_MAX_BYTES=8388608
IMPORT_FIXTURE_DIR=
IMPORT_DIGEST_ENABLED=true
IMPORT_PREVIEW_CACHE_TTL_S=86400

# Compose only. MINIO_ACCESS_KEY/SECRET_KEY must equal MINIO_ROOT_USER/PASSWORD until service accounts exist.
ENV_FILE=.env
WEB_PORT=8081
POSTGRES_PASSWORD=CHANGE_ME
EVENTS_APP_PASSWORD=CHANGE_ME
EVENTS_MIGRATOR_PASSWORD=CHANGE_ME
EVENTS_PUBLIC_PASSWORD=CHANGE_ME
EVENTS_SUBS_PASSWORD=CHANGE_ME
ALTCHA_ROOT_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
